# ============================================================
# GlitchTip - Variables de Entorno
# ============================================================

# Puerto de la aplicación web
GLITCHTIP_PORT=4000

# Dominio (cambiar en producción)
GLITCHTIP_DOMAIN=http://localhost:4000

# PostgreSQL
POSTGRES_PASSWORD=password

# Secret Key (GENERAR UNO NUEVO EN PRODUCCIÓN)
# Para generar: python3 -c "import secrets; print(secrets. token_urlsafe(32))"
SECRET_KEY=secret_key

# Valkey (Redis fork)
VALKEY_MAXMEMORY=256mb

# Email (opcional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost

# Logging
LOG_LEVEL=INFO
