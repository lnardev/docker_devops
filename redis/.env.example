# Definir la contraseña si es necesario, si no usa ALLOW_EMPTY_PASSWORD=yes
REDIS_PASSWORD=Ejemplo123***

# Establecer el puerto de Redis
REDIS_PORT=6381

# Permitir contraseñas vacías solo para desarrollo (opcional)
ALLOW_EMPTY_PASSWORD=no

# Nombre del contenedor (No pueden correr 2 contenedores con el mismo nombre simultaneamente)
REDIS_CONTAINER_NAME=redis_cdg_desarrollo
